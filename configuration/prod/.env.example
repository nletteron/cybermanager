# Copy outside Git, replace both secrets, and create the absolute dump directory.
CM_IMAGE_PREFIX=cybermanager
CM_IMAGE_TAG=1.0.0
CM_DB_PASSWORD=replace-with-a-unique-database-password
CM_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CM_DB_VOLUME_NAME=cybermanager-prod-postgres-data
CM_DATABASE_BACKUP_CONTAINER=cybermanager-prod-db
CM_DATABASE_DUMP_HOST_DIR=/srv/cybermanager/dumps
# Windows with Linux containers: D:/cybermanager/dumps

# Linux: stat -c '%g' /var/run/docker.sock ; Docker Desktop usually uses group 0.
CM_DOCKER_SOCKET=/var/run/docker.sock
CM_DOCKER_GID=0

CM_FRONT_BIND=0.0.0.0
CM_FRONT_PORT=8080
CM_AUTH_API_URL=/auth-api
CM_API_URL=/api

# Only for the first installation on a checked, fresh database; set false afterwards.
CM_FLYWAY_BASELINE_ON_MIGRATE=true

# Optional absolute paths, defaults are relative to configuration/prod/docker-compose.yml.
# CM_AUTH_CONFIG_DIR=/etc/cybermanager/auth
# CM_API_CONFIG_DIR=/etc/cybermanager/cybermanager
# CM_NGINX_CONFIG_FILE=/etc/cybermanager/nginx/default.conf

CM_JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
CM_DATABASE_DUMP_MAX_SIZE=1GB
